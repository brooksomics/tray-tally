{
  "name": "tray-tally",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "prek install",
    "fetch": "node src/run.ts",
    "lint": "NODE_OPTIONS=--disable-warning=ExperimentalWarning eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "typecheck": "tsc",
    "test": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-coverage-lines=80 '--test-coverage-include=src/**' '--test-coverage-include=dashboard/**'",
    "check": "npm run lint && prettier --check . && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@j178/prek": "^0.5.5",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
